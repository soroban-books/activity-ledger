{
  "name": "activity-ledger",
  "version": "0.1.0",
  "description": "Soroban-aware activity ledger: decode, classify, price and export Stellar account activity as books.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/soroban-books/activity-ledger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soroban-books/activity-ledger.git"
  },
  "bugs": {
    "url": "https://github.com/soroban-books/activity-ledger/issues"
  },
  "keywords": [
    "stellar",
    "soroban",
    "blend",
    "soroswap",
    "defi",
    "accounting",
    "tax",
    "koinly",
    "ledger",
    "cli"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "activity-ledger": "dist/cli.js"
  },
  "files": [
    "dist",
    "web",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "cli": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "serve": "node src/cli.ts serve",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "hyparquet": "^1.31.5",
    "typescript": "^7.0.2"
  }
}
